<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限只声明必需的。区块 2 的结论：
        · 文件选择走系统 SAF（FileChooserParams.createIntent），不需要任何存储权限；
        · 下载走 DownloadManager：Android 10 及以上写公共“下载”目录不需要权限；
          Android 8/9（API 26~28）需要写权限才能落公共目录（管理员 2026-10-11 确认），
          因此下面的写权限用 maxSdkVersion="28" 限定，Android 10+ 的机器上不会生效；
          权限被拒时壳会退回 App 目录，下载依旧可用；
        · 只有拍照需要 CAMERA：一旦在清单里声明它，系统就要求调用方自己持有，
          否则 ACTION_IMAGE_CAPTURE 会被拒，所以壳必须主动申请。
      读取媒体库、读取外部存储类权限一个都不申请（见 docs/SECURITY.md 第 2 节）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!--
      更新（区块 3）：安装自己下载的更新包需要它。Android 8.0 起它不再是“开关式”权限，
      而是由用户在系统「安装未知应用」页面逐个允许；壳不会绕过这一步（见 shell/update/UpdateInstaller）。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 没有摄像头的设备（平板、部分模拟器）也要能安装 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      Android 11 及以上的包可见性：声明后才能 queryIntentActivities 找到相机 App，
      从而把“拍照”作为额外入口塞进文件选择器（见 shell/CameraCapture）。
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!--
      android:name=".ClubApp"：Application 里只装一件事——崩溃自记录（见 shell/CrashReporter）：
      未捕获异常先落盘，下次启动时弹出来，用户点一下就能复制/分享堆栈。
      为什么需要：用户手机上既没有 adb 也读不到 logcat，2026-10-12 的启动闪退因此只能靠读代码反推
      （见 docs/FIX-20261012-STARTUP-CRASH.md）。
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".ClubApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme_ClubApp"
        android:usesCleartextTraffic="false">

        <!--
          configChanges：避免旋转/分屏/深色切换时重建 Activity（重建会丢 WebView 页面状态）。
          launchMode=singleTask：深链复用同一个实例，不会堆出多个 WebView。
          theme：区块 4 的启动页主题（windowBackground = 纯色 + 社徽），
                 MainActivity.onCreate 第一件事就 setTheme(R.style.Theme_ClubApp) 切回常规主题。
                 主题名用下划线而非点号的原因见 values/themes.xml 的说明。
          enableOnBackInvokedCallback：区块 4 开启 Android 13+ 的预测式返回，
                 具体行为由 MainActivity 的 OnBackPressedCallback 决定（双击才退出）。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme_ClubApp_Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              深链：从浏览器等处点开本站链接可直接进 App。
              注意：站点目前用 IP（8.153.145.175），无法做 App Links 官方校验（需域名 + assetlinks.json），
              所以首次点击时系统会询问“打开方式”。以后换成域名可补 android:autoVerify="true"。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="8.153.145.175" />
            </intent-filter>
        </activity>

        <!--
          拍照输出、分享图片、更新包的临时文件都通过 FileProvider 交给对方 App/系统安装器
          （不用存储权限）。authorities 必须与 AppConfig.FILE_PROVIDER_AUTHORITY 一致（同一串），
          否则 getUriForFile 会抛异常；用 ${applicationId} 前缀，debug 变体才不会被写死的包名坑到。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
