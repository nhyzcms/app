<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限只声明必需的。区块 2 的结论：
        · 文件选择走系统 SAF（FileChooserParams.createIntent），不需要任何存储权限；
        · 下载走 DownloadManager：Android 10 及以上写公共“下载”目录不需要权限；
          Android 8/9（API 26~28）需要写权限才能落公共目录（管理员 2026-10-11 确认），
          因此下面的写权限用 maxSdkVersion="28" 限定，Android 10+ 的机器上不会生效；
          权限被拒时壳会退回 App 目录，下载依旧可用；
        · 只有拍照需要 CAMERA：一旦在清单里声明它，系统就要求调用方自己持有，
          否则 ACTION_IMAGE_CAPTURE 会被拒，所以壳必须主动申请。
      读取媒体库、读取外部存储类权限一个都不申请（见 docs/SECURITY.md 第 2 节）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!--
      更新（区块 3）：安装自己下载的更新包需要它。Android 8.0 起它不再是“开关式”权限，
      而是由用户在系统「安装未知应用」页面逐个允许；壳不会绕过这一步（见 shell/update/UpdateInstaller）。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      区块 5（消息与角标）：Android 13（API 33）起发通知需要运行时权限。
      低版本上这条声明不生效（系统视为已授予）。被拒绝时壳不发通知、也不显示角标，
      网页里的未读徽标照常工作；不会反复弹窗骚扰（见 shell/push/PushHost）。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      常驻后台（区块 5 补强，2026-10-17）：用户明确要求「退到后台也要实时提醒」，
      壳用**前台服务**把 WebSocket 连接与进程一起保活（见 shell/push/PushService）。

      · FOREGROUND_SERVICE：API 28 起启动前台服务的前提；
      · FOREGROUND_SERVICE_DATA_SYNC：API 34 起按类型额外校验（服务在清单里声明 dataSync）；
      · REQUEST_IGNORE_BATTERY_OPTIMIZATIONS：Doze 会掐断长连接，需要用户允许「忽略电池优化」。
        这条权限只允许弹出系统的**允许对话框**，不能自己改设置；用户随时可撤回。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 没有摄像头的设备（平板、部分模拟器）也要能安装 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      Android 11 及以上的包可见性：声明后才能 queryIntentActivities 找到相机 App，
      从而把“拍照”作为额外入口塞进文件选择器（见 shell/CameraCapture）。
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!--
      android:name=".ClubApp"：Application 里装两件事——崩溃自记录（见 shell/CrashReporter）
      与区块 5 的消息/角标（见 shell/push/PushHost）：
      未捕获异常先落盘，下次启动时弹出来，用户点一下就能复制/分享堆栈。
      为什么需要：用户手机上既没有 adb 也读不到 logcat，2026-10-12 的启动闪退因此只能靠读代码反推
      （见 docs/FIX-20261012-STARTUP-CRASH.md）。
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".ClubApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme_ClubApp"
        android:usesCleartextTraffic="false">

        <!--
          configChanges：避免旋转/分屏/深色切换时重建 Activity（重建会丢 WebView 页面状态）。
          launchMode=singleTask：深链复用同一个实例，不会堆出多个 WebView。
          theme：区块 4 的启动页主题（windowBackground = 纯色 + 社徽），
                 MainActivity.onCreate 第一件事就 setTheme(R.style.Theme_ClubApp) 切回常规主题。
                 主题名用下划线而非点号的原因见 values/themes.xml 的说明。
          enableOnBackInvokedCallback：区块 4 开启 Android 13+ 的预测式返回，
                 具体行为由 MainActivity 的 OnBackPressedCallback 决定（双击才退出）。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme_ClubApp_Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              深链：从浏览器等处点开本站链接可直接进 App。
              注意：站点目前用 IP（8.153.145.175），无法做 App Links 官方校验（需域名 + assetlinks.json），
              所以首次点击时系统会询问“打开方式”。以后换成域名可补 android:autoVerify="true"。
              区块 5 的未读通知也复用它：PendingIntent 发的是同一形态的站内深链
              （https://8.153.145.175/#/messages/12）。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="8.153.145.175" />
            </intent-filter>
        </activity>

        <!--
          原生扫码（区块 8 增补）：扫工牌二维码 / Code128 条码，扫到的文本交给
          shell/scan/ScanRouter 决定落到站内哪个页面（业务判断仍在网页）。

          · exported=false：只由 MainActivity 启动，外部应用不能拉起；
          · screenOrientation=portrait：库自带的 CaptureActivity 是 sensorLandscape，
            凑近工牌扫描竖屏更顺手；
          · theme：黑底相机页（Theme_ClubApp_Scan）。
        -->
        <activity
            android:name=".shell.scan.ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme_ClubApp_Scan"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!--
          常驻后台（区块 5 补强）：用户退到界面外后，由这个前台服务把进程与 WS 连接保活，
          从而「有新私信/通知就立刻提醒」。此前 onActivityStopped 里直接断开连接，
          因此 App 一退到后台就再也收不到东西（2026-10-17 管理员反馈）。

          · exported=false：只由本应用启动；
          · foregroundServiceType=dataSync：API 34 起前台服务必须声明类型；
          · stopWithTask=false：从最近任务里划掉也不停（配合 START_STICKY 一起保活）。
        -->
        <service
            android:name=".shell.push.PushService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!--
          拍照输出、分享图片、更新包的临时文件都通过 FileProvider 交给对方 App/系统安装器
          （不用存储权限）。authorities 必须与 AppConfig.FILE_PROVIDER_AUTHORITY 一致（同一串），
          否则 getUriForFile 会抛异常；用 ${applicationId} 前缀，debug 变体才不会被写死的包名坑到。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
