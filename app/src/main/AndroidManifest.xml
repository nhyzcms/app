<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限只声明必需的。区块 2 的结论：
        · 文件选择走系统 SAF（FileChooserParams.createIntent），不需要任何存储权限；
        · 下载走 DownloadManager，Android 10 及以上写公共“下载”目录同样不需要权限；
        · 只有拍照需要 CAMERA：一旦在清单里声明它，系统就要求调用方自己持有，
          否则 ACTION_IMAGE_CAPTURE 会被拒，所以壳必须主动申请。
      读写外部存储、读取媒体库类权限一个都不申请（见 docs/SECURITY.md 第 2 节）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 没有摄像头的设备（平板、部分模拟器）也要能安装 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      Android 11 及以上的包可见性：声明后才能 queryIntentActivities 找到相机 App，
      从而把“拍照”作为额外入口塞进文件选择器（见 shell/CameraCapture）。
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClubApp"
        android:usesCleartextTraffic="false">

        <!--
          configChanges：避免旋转/分屏/深色切换时重建 Activity（重建会丢 WebView 页面状态）。
          launchMode=singleTask：深链复用同一个实例，不会堆出多个 WebView。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              深链：从浏览器等处点开本站链接可直接进 App。
              注意：站点目前用 IP（8.153.145.175），无法做 App Links 官方校验（需域名 + assetlinks.json），
              所以首次点击时系统会询问“打开方式”。以后换成域名可补 android:autoVerify="true"。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="8.153.145.175" />
            </intent-filter>
        </activity>

        <!--
          拍照输出的临时文件通过 FileProvider 交给相机 App（不申请存储权限）。
          authorities 必须与 shell/CameraCapture.AUTHORITY 完全一致，否则 getUriForFile 会抛异常；
          这里用 ${applicationId} 前缀，debug 变体（带 .debug 后缀）才不会被写死的包名坑到。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
