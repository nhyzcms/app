<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：取自社徽的「三道波 + 圆点」意象（传媒/广播）。
  说明：这是意象化简化，不是社徽原图的精确矢量化；若拿到 SVG/AI 原文件可按原坐标重建。

  画布 108x108，安全区是中心直径 66 的圆（约 21~87），本图形落在 34~82 之间，不会被裁切。
  纯矢量、无位图 → 仓库里没有二进制资源，体积为零。
  底色由 @color/brand 提供（见 values/ic_launcher_background.xml）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 左波（矮） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,76 C36,62 39,50 46,44 C46,58 43,68 42,76 Z" />

    <!-- 中波（最高，取社徽的浅蓝） -->
    <path
        android:fillColor="@color/brand_accent"
        android:pathData="M48,76 C48,56 51,42 58,36 C60,52 57,66 55,76 Z" />

    <!-- 右波（中） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M60,76 C61,64 65,54 72,50 C72,62 68,70 66,76 Z" />

    <!-- 社徽右下角那颗圆点 -->
    <path
        android:fillColor="@color/brand_accent"
        android:pathData="M74,66 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
</vector>
