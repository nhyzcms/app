<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      品牌色：取自社徽，与网站 frontend/src/styles/cobalt.css 的品牌令牌同源（SEAL BLUE）。
      改色时请同时改网站令牌，保持两端一致。

      ⚠️ 踩坑记录：XML 注释里不能出现两个连续的短横线（英文减号），
      也不要把包含这种字符的报错原文照抄进注释里（已因此栽过两次），
      否则 AAPT 会以 not permitted within comments 为理由中断整个构建。
    -->
    <color name="brand">#0756A2</color>
    <!-- 社徽里的浅蓝（网站 cobalt 令牌里的 brand 300），用于图标、强调色 -->
    <color name="brand_accent">#79C2FA</color>

    <!--
      窗口底色 = 网页底色（浅色 #ffffff，与站点 meta name="theme-color" 的浅色值一致）。
      区块 4 起，窗口底色/状态栏色会在运行时跟随**网页主题色**（见 shell/feel/PageTheme）；
      这里的值只负责第一帧之前的兜底。
    -->
    <color name="window_background">#FFFFFF</color>
    <color name="text_primary">#111827</color>
    <color name="text_secondary">#6B7280</color>

    <!-- 区块 4：首屏骨架屏的占位块 -->
    <color name="skeleton">#ECEFF3</color>

    <!-- 区块 4：返回顶部浮动按钮 -->
    <color name="fab_background">#FFFFFF</color>
    <color name="fab_icon">#0756A2</color>
</resources>
