<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      基础主题：DayNight 跟随系统深浅色。
      说明：站点自己实现了深色模式（localStorage 键 cobalt:theme），壳只保证
      窗口底色与系统栏在两种模式下都不刺眼；页面配色由网页负责，
      而壳的底色会在运行时跟随网页的 meta theme-color（见 shell/feel/PageTheme）。

      深浅色的差异全部通过资源引用表达（@color/window_background、@bool/light_system_bar_icons），
      因此**不需要** values-night 里再写一份 style（同名 style 是整体替换，很容易漏 item）。
    -->
    <style name="Theme.ClubApp.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bar_icons</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bar_icons</item>
    </style>

    <!--
      区块 4 启动页（API 26 ~ 30 走这条）：windowBackground 换成「纯色 + 居中社徽」，
      系统会一直显示到第一帧内容画好 —— 零代码、零白屏闪烁。
      API 31+ 由系统 SplashScreen 接管，见 values-v31/themes.xml。
    -->
    <style name="Theme.ClubApp.Splash" parent="Theme.ClubApp.Base">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- 应用真正使用的主题：启动页之后由 MainActivity.onCreate 里 setTheme 切过来。 -->
    <style name="Theme.ClubApp" parent="Theme.ClubApp.Splash">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
