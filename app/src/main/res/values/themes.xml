<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      基础主题：DayNight 跟随系统深浅色。
      说明：站点自己实现了深色模式（localStorage 键 cobalt:theme），壳只保证
      窗口底色与系统栏在两种模式下都不刺眼；页面配色由网页负责，
      而壳的底色会在运行时跟随网页的 meta theme-color（见 shell/feel/PageTheme）。

      深浅色的差异全部通过资源引用表达（@color/window_background、@bool/light_system_bar_icons），
      因此**不需要** values-night 里再写一份 style（同名 style 是整体替换，很容易漏 item）。

      命名为什么用下划线而不是惯例的点号（Theme.ClubApp.Splash）：
      scripts/preflight.sh 会把 Kotlin 里的 R.style.X 与资源名逐字比对，而点号在 R 类里
      会被换成下划线（Theme.ClubApp → R.style.Theme_ClubApp），含点号的资源名会被误判成
      「资源不存在」。层级关系本来就由 parent 表达，用下划线名可以两头都对得上。
    -->
    <style name="Theme_ClubApp_Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bar_icons</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bar_icons</item>
    </style>

    <!--
      区块 4 启动页（API 26 ~ 30 走这条）：windowBackground 换成「纯色 + 居中社徽」，
      系统会一直显示到第一帧内容画好 —— 零代码、零白屏闪烁。
      API 31+ 由系统 SplashScreen 接管，见 values-v31/themes.xml。
    -->
    <style name="Theme_ClubApp_Splash" parent="Theme_ClubApp_Base">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- 应用真正使用的主题：启动页之后由 MainActivity.onCreate 里 setTheme 切过来。 -->
    <style name="Theme_ClubApp" parent="Theme_ClubApp_Splash">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
      扫码页（区块 8 增补）：相机取景页恒为黑底，系统栏图标反过来用浅色。
      父主题故意用系统 Material（而非 Theme_ClubApp_Base）：ScanActivity 继承自
      ZXing 的 CaptureActivity（普通 Activity，不是 AppCompatActivity），
      用 AppCompat 主题会在没有 AppCompatDelegate 的情况下引入不必要的依赖假设。
    -->
    <style name="Theme_ClubApp_Scan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/scan_background</item>
        <item name="android:statusBarColor">@color/scan_background</item>
        <item name="android:navigationBarColor">@color/scan_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
